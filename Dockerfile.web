# syntax=docker/dockerfile:1
FROM node:24-bookworm-slim AS frontend
WORKDIR /build
ENV CI=true
RUN corepack enable && corepack prepare pnpm@11.25.0 --activate
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY web/ ./
RUN pnpm build

FROM python:3.14-slim-bookworm AS runtime
COPY --from=ghcr.io/astral-sh/uv:0.12.19 /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PATH="/app/.venv/bin:$PATH" WEB_DIST=/app/web/dist PYTHONUNBUFFERED=1
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project
COPY src/ src/
COPY stations.csv ./
COPY data/ data/
COPY docker/history-imports.json docker/history-imports.json
RUN uv sync --frozen --no-dev && useradd --create-home --uid 10001 fieldwork
COPY --from=frontend /build/dist/ web/dist/
USER fieldwork
EXPOSE 8000
CMD ["uvicorn", "as_db.web.api:app", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers"]
