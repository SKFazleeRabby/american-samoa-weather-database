# Database name used by both PostgreSQL and pgAdmin.
POSTGRES_DB=weather
POSTGRES_USER=postgres
POSTGRES_HOST=127.0.0.1
# Set a strong password before starting the container. Do not commit .env.
# Single-quote the value if it contains dollar signs or hash characters.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Website database account: separate from the administrator above.
# Set a different strong password. web-setup provisions SELECT-only access.
APP_DB_USER=weather_reader
APP_DB_PASSWORD=
WEB_PORT=8080

# Public website overlay (compose.public.yaml). Default: http://DROPLET_IP
# No domain needed. Later, use a domain name here to enable automatic HTTPS.
PUBLIC_SITE_ADDRESS=:80

# Separate login for an AI server connecting through an SSH tunnel.
# Generate a unique password with: openssl rand -hex 32
# Provision explicitly: docker compose --profile agent run --rm agent-setup
AGENT_DB_USER=weather_agent
AGENT_DB_PASSWORD=

# Collection worker only; never sent to the web browser or baked into an image.
SYNOPTIC_TOKEN=
HCDP_API=
# Startup collects after each variable's last historical CSV date through yesterday.
# UH Mesonet: HCDP first, Synoptic fallback. WRCC: sam1/sam2. Airport: NSTU.
# Timezone of the daily 03:00 schedule. Observation dates use station timezones.
COLLECTION_TIMEZONE=Pacific/Pago_Pago

# pgAdmin browser login (separate from the PostgreSQL account).
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_PORT=5050
